{
  "project_name": "PINO-DR v6 (Smartphone-Only Intelligent Dead Reckoning)",
  "version": "6.0.0-production",
  "sampling_rate_hz": 10,
  "dt": 0.1,
  "window_size_10hz": 20,
  "outage_duration_s": 10,
  "outage_steps_10hz": 100,
  "sensor_source": "smartphone_IMU_only",
  "external_sensors_used": false,
  "can_or_wheel_speed_used": false,

  "dataset": {
    "base_dir": "C:\\Users\\tiwar\\OneDrive\\Desktop\\DATASETS\\IO-VNBD\\IO-VNBD\\Synchronised V abd S datasets\\Categorised IOVNB Dataset",
    "train_trips": 50,
    "val_trips": 9,
    "test_trips": 13,
    "split_seed": 42
  },

  "clip_limits": {
    "accel_fwd": [-8.0, 8.0],
    "accel_lat": [-8.0, 8.0],
    "gyro_yaw": [-1.2, 1.2],
    "yaw_accel": [-4.0, 4.0],
    "centripetal_residual": [-8.0, 8.0],
    "velocity": [0.0, 45.0],
    "delta_v": [-4.0, 4.0]
  },

  "model": {
    "in_channels": 6,
    "conv_channels": 32,
    "gru_hidden": 32,
    "num_gru_layers": 1,
    "dropout": 0.15,
    "max_parameter_budget": 25000
  },

  "training": {
    "batch_size": 256,
    "learning_rate": 8e-4,
    "weight_decay": 1e-4,
    "max_epochs": 800,
    "patience": 20,
    "rollout_horizons_s": [1, 3, 5, 10],
    "loss_weights": {
      "velocity": 1.2,
      "heading": 3.5,
      "position": 0.8,
      "zupt": 0.25,
      "physics": 0.05,
      "bias": 0.05,
      "uncertainty": 0.01
    }
  },

  "ekf": {
    "state_dim": 6,
    "state_names": ["x", "y", "v", "psi", "b_a", "b_w"],
    "q_pos": 0.05,
    "q_vel": 0.15,
    "q_psi": 0.02,
    "q_bias_a": 0.001,
    "q_bias_w": 0.0005,
    "r_vel_neural": 0.30,
    "r_yaw_neural": 0.05,
    "r_nhc_lat": 0.20,
    "r_zupt": 0.01
  },

  "map_matching": {
    "enabled": true,
    "search_radius_m": 40.0,
    "heading_weight": 1.2,
    "distance_weight": 1.0,
    "transition_weight": 0.8,
    "max_candidates": 5
  }
}
